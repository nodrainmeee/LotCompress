
* { font-family: "Segoe UI", "Inter", sans-serif; font-size: 10pt; }
QWidget { background: #f5f6f8; color: #1f2328; }
QLabel#appTitle { font-size: 18pt; font-weight: 700; color: #10b981; }
QLabel#muted { color: #6b7280; }
QLabel#dropTitle { font-size: 13pt; font-weight: 600; }
QLabel#savedLabel { font-weight: 600; color: #10b981; padding: 0 8px; }
QFrame#dropZone { border: 2px dashed #d8dce2; border-radius: 14px; background: #ffffff; }
QFrame#dropZone[active="true"] { border-color: #10b981; background: #d1fae5; }
QFrame#dropZone QLabel { background: transparent; }
QGroupBox { background: #ffffff; border: 1px solid #d8dce2; border-radius: 12px; margin-top: 14px; padding: 12px; font-weight: 600; }
QGroupBox::title { subcontrol-origin: margin; left: 12px; padding: 0 4px; background: transparent; }
QGroupBox QWidget, QGroupBox QLabel, QGroupBox QCheckBox { background: transparent; font-weight: 400; }
QLabel#previewImage { background: #eef0f3; border-radius: 8px; color: #6b7280; }
QPushButton { background: #ffffff; border: 1px solid #d8dce2; border-radius: 8px; padding: 7px 14px; }
QPushButton:hover { border-color: #10b981; }
QPushButton:disabled { color: #6b7280; }
QPushButton#primary { background: #10b981; color: white; border: none; font-weight: 600; padding: 8px 22px; }
QPushButton#primary:disabled { background: #d8dce2; }
QComboBox, QSpinBox, QLineEdit, QDateTimeEdit, QGroupBox QComboBox, QGroupBox QSpinBox, QGroupBox QLineEdit, QGroupBox QDateTimeEdit { background: #eef0f3; border: 1px solid #d8dce2; border-radius: 6px; padding: 4px 8px; }
QCheckBox#danger { color: #ef4444; }
QSlider::groove:horizontal { height: 6px; background: #d8dce2; border-radius: 3px; }
QSlider::sub-page:horizontal { background: #10b981; border-radius: 3px; }
QSlider::handle:horizontal { background: #10b981; width: 16px; margin: -6px 0; border-radius: 8px; }
QProgressBar { background: #eef0f3; border: none; border-radius: 5px; height: 10px; text-align: center; }
QProgressBar::chunk { background: #10b981; border-radius: 5px; }
QTableWidget { background: #ffffff; alternate-background-color: #eef0f3; border: 1px solid #d8dce2; border-radius: 10px; gridline-color: transparent; selection-background-color: #d1fae5; selection-color: #1f2328; }
QHeaderView::section { background: #eef0f3; color: #6b7280; border: none; padding: 6px; font-weight: 600; }
QTabWidget::pane { border: none; }
QTabBar::tab { background: transparent; padding: 8px 18px; color: #6b7280; }
QTabBar::tab:selected { color: #1f2328; border-bottom: 2px solid #10b981; }
QStatusBar { color: #6b7280; }
QSplitter::handle { background: transparent; }

QLineEdit:focus, QDateTimeEdit:focus, QComboBox:focus { border-color: #10b981; }
QScrollArea { background: transparent; }
